# Copy this file to ".env" and fill in your real values.
# The .env file is git-ignored so your key never gets committed or shipped.

# DigitalOcean Serverless Inference
DO_INFERENCE_KEY=your-key-here
DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1

# Optional: a GitHub token raises the API rate limit from 60/hr to 5000/hr.
# Not required for ingestion. Leave blank if you don't have one.
GITHUB_TOKEN=
